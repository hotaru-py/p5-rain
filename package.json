{
  "name": "p5.rain",
  "version": "0.1.0",
  "private": true,
  "description": "Technical demo: NASA IMERG precipitation as a live, interactive pixel field for p5.js.",
  "type": "module",
  "main": "dist/p5.rain.js",
  "module": "dist/p5.rain.esm.js",
  "exports": {
    ".": {
      "import": "./dist/p5.rain.esm.js",
      "default": "./dist/p5.rain.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "node --test test/unit.test.mjs",
    "test:browser": "node test/browser.test.mjs",
    "examples": "npx --yes http-server . -c-1 -o /examples/",
    "prepare": "node scripts/build.mjs"
  },
  "peerDependencies": {
    "p5": ">=1.8.0"
  },
  "devDependencies": {
    "esbuild": "0.25.0",
    "puppeteer-core": "25.16.0"
  },
  "author": "Prajesh Raam",
  "license": "MIT"
}
